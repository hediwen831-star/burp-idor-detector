# EditorConfig —— 统一不同编辑器/IDE 的缩进与换行风格
# https://editorconfig.org
#
# 本项目在 Windows 上开发、在 Linux（CI）上构建。
# 没有统一配置时，一次保存就可能把整个文件的行尾改掉，
# 产生的 diff 里全是与内容无关的噪声。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Maven POM 与配置文件的惯例缩进是 2 空格
[*.{xml,yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown 里「行尾两个空格」是硬换行语法，不能自动删掉
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

# Windows 批处理必须 CRLF —— 部分 cmd 解析器对 LF 会出错。
# .gitattributes 里有对应规则，两处必须保持一致。
[*.{bat,cmd}]
end_of_line = crlf
# 构建产物目录（编辑器通常不会去扫，写在这里是给 IDE 索引用的）
[target/**]
indent_size = 4
